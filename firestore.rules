rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- USER PROFILES & CONTACTS ---
    match /users/{userId} {
      // Users can only manage their own profile and metadata
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Sub-collections: Only the owner can access their own contacts or keys
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /groups/{groupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- GROUPS & GROUP E2EE ---
    match /groups/{groupId} {
      // Anyone logged in can create a group
      allow create: if request.auth != null;
      
      // Members can read group metadata
      allow read: if request.auth != null && (request.auth.uid in resource.data.members);
      
      // Allow updates if you are a member
      allow update: if request.auth != null && (request.auth.uid in resource.data.members);

      // Group Messages
      match /messages/{messageId} {
        // Only members can read/write messages in this group
        allow read, write: if request.auth != null && (get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid]));
      }

      // Group E2EE Keys
      match /e2ee_keys/{uid} {
        // Each member can only read their own wrapped key
        allow read: if request.auth != null && request.auth.uid == uid;
        // The person wrapping/adding others can write here
        allow write: if request.auth != null;
      }
    }

    // --- PRIVATE CHAT ROOMS ---
    match /messages_rooms/{roomId} {
       // A room ID typically contains both user IDs (e.g., uid1_uid2)
       // We allow read/write if the user is part of the ID string
       allow read, write: if request.auth != null && roomId.contains(request.auth.uid);
       
       match /messages/{messageId} {
         allow read, write: if request.auth != null && roomId.contains(request.auth.uid);
       }
    }

    // --- FILE TRACKING ---
    match /files/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
