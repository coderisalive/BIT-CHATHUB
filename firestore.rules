rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- USER PROFILES ---
    match /users/{userId} {
      // Allow getting a specific user document (needed for E2EE public keys)
      // but PREVENT listing all users to protect email privacy.
      allow get: if request.auth != null;
      allow list: if false; 

      // Users can only write to their own document
      allow write: if request.auth != null && request.auth.uid == userId;

      // Sub-collections (Contacts, Meta, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- PRIVATE CHATS ---
    match /chats/{chatId} {
      // Room IDs are usually uid1_uid2. Only participants can access.
      allow read, write: if request.auth != null && chatId.contains(request.auth.uid);
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && chatId.contains(request.auth.uid);
      }
    }

    // --- GROUPS ---
    match /groups/{groupId} {
      // Anyone logged in can create a group
      allow create: if request.auth != null;
      
      // Members can read group metadata and messages
      allow read, update: if request.auth != null && (request.auth.uid in resource.data.members);

      // Group Messages
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid]));
      }

      // Group E2EE Keys
      match /e2ee_keys/{uid} {
        // Each member can only read their own wrapped key
        allow read: if request.auth != null && request.auth.uid == uid;
        // The person wrapping/adding others can write here
        allow write: if request.auth != null;
      }
    }

    // --- FILE TRACKING ---
    match /files/{fileId} {
      allow read, write: if request.auth != null;
    }
  }
}
